# --- Демо-пользователь (единственный, user_id фиксирован; RLS всё равно включён) ---
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# --- PostgreSQL ---
POSTGRES_PASSWORD=postgres
POSTGRES_APP_PASSWORD=app_secret

# --- Webhook от CRM ---
WEBHOOK_SECRET=dev_webhook_secret

# --- LLM (OpenAI-совместимый API; mock = работа без ключа) ---
LLM_PROVIDER=mock
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- STT / TTS (mock = голосовой конвейер без внешних ключей) ---
STT_PROVIDER=mock
STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=
TTS_PROVIDER=mock
TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=

# --- Asterisk ARI ---
ARI_USER=ari
ARI_PASSWORD=ari_secret
